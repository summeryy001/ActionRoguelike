# Visual Studio user specific files
.vs/
.vsconfig

# Rider
.idea/
Plugins/Developer/RiderLink
*.DotSettings.user

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Debug Files
*.pdb

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb


# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*/*
Plugins/*/Binaries/*
# AR2: compiled binaries are reproducible and are not versioned


# Builds
Build/*
*.modules

# File Open Order
Build/Windows/FileOpenOrder/*

# pso cache files
!Build/Windows/PipelineCaches/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
# *_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*
Config/HoloLens/HoloLensEngine.ini
Platforms/HoloLens/Config/HoloLensEngine.ini

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# AR2 local build and capture outputs
/Binaries/
/Saved/
/Intermediate/
/DerivedDataCache/
/CollectedPSOs/
*.utrace
*.ucache
*.rec.upipelinecache
*.shk
*.stable.upipelinecache
# Version the deliberate bundled PSO build inputs in later stages.
!Build/Windows/
!Build/Windows/PipelineCaches/
!Build/Windows/PipelineCaches/*.spc
